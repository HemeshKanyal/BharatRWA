# BharatRWA Makefile
# ==================

-include .env

.PHONY: all build test clean deploy

# ============================================================
#                    BUILD & TEST
# ============================================================

build:
	forge build

test:
	forge test -vvv

test-gas:
	forge test --gas-report

test-fuzz:
	forge test --fuzz-runs 1000 -vvv

snapshot:
	forge snapshot

fmt:
	forge fmt

lint:
	forge fmt --check

clean:
	forge clean

# ============================================================
#                    DEPLOYMENT
# ============================================================

deploy-local:
	forge script script/DeployAll.s.sol:DeployAll \
		--rpc-url http://127.0.0.1:8545 \
		--broadcast \
		-vvvv

deploy-sepolia:
	forge script script/DeployAll.s.sol:DeployAll \
		--rpc-url $(SEPOLIA_RPC_URL) \
		--private-key $(PRIVATE_KEY) \
		--broadcast \
		--verify \
		--etherscan-api-key $(ETHERSCAN_API_KEY) \
		-vvvv

# ============================================================
#                    LOCAL NODE
# ============================================================

anvil:
	anvil --block-time 2

# ============================================================
#                    ZK CIRCUIT
# ============================================================

zk-compile:
	cd ../zk_kyc && nargo compile

zk-execute:
	cd ../zk_kyc && nargo execute

zk-prove:
	cd ../zk_kyc && bb prove \
		-b ./target/zk_kyc.json \
		-w ./target/zk_kyc.gz \
		-o ./target/proof \
		-t evm --verify

zk-verify:
	cd ../zk_kyc && bb verify \
		-p ./target/proof \
		-k ./target/vk/vk

zk-verifier:
	cd ../zk_kyc && \
	nargo compile && \
	bb write_vk -b ./target/zk_kyc.json -o ./target/vk/ -t evm && \
	bb write_solidity_verifier -k ./target/vk/vk -o ../bharat-rwa/src/UltraVerifier.sol -t evm
	@echo "HonkVerifier (Solidity) generated at src/UltraVerifier.sol"

# Verifier for the backend circuit (public input = wallet address), used by
# ComplianceManagerV2 to bind proofs to msg.sender. Also refreshes the test
# fixture proof for wallet 0x1111...1111.
ZK_WALLET_BOUND = ../backend/zk_kyc
FIXTURE_WALLET = 97433442488726861213578988847752201310395502865
zk-verifier-wallet-bound:
	cd $(ZK_WALLET_BOUND) && \
	nargo compile && \
	printf 'age = 25\nkyc_verified = true\nsanctioned = false\nwallet = "$(FIXTURE_WALLET)"\nsecret = "123456789"\nexpected_wallet_hash = "$(FIXTURE_WALLET)"\n' > Prover.toml && \
	nargo execute && \
	bb write_vk -b ./target/zk_kyc.json -o ./target/vk -t evm && \
	bb prove -b ./target/zk_kyc.json -w ./target/zk_kyc.gz -k ./target/vk/vk -o ./target/proof -t evm && \
	bb write_solidity_verifier -k ./target/vk/vk -o ./target/HonkVerifier.sol -t evm
	{ printf '// Generated by `make zk-verifier-wallet-bound` from backend/zk_kyc (wallet_hash = wallet)\n// with nargo $$(nargo --version | head -1 | awk "{print \$$4}") and bb $$(bb --version) (-t evm). Do not edit by hand.\n'; \
	  sed 's/^contract HonkVerifier is/contract WalletBoundHonkVerifier is/' $(ZK_WALLET_BOUND)/target/HonkVerifier.sol; } > src/zk/WalletBoundHonkVerifier.sol
	cp $(ZK_WALLET_BOUND)/target/proof/proof $(ZK_WALLET_BOUND)/target/proof/public_inputs test/fixtures/zk/
	@echo "WalletBoundHonkVerifier generated at src/zk/WalletBoundHonkVerifier.sol"

# ============================================================
#                    UTILITIES
# ============================================================

sizes:
	forge build --sizes

slither:
	slither src/

help:
	@echo "BharatRWA Makefile Commands:"
	@echo "  make build          - Compile contracts"
	@echo "  make test           - Run all tests (verbose)"
	@echo "  make test-gas       - Run tests with gas report"
	@echo "  make test-fuzz      - Run fuzz tests (1000 runs)"
	@echo "  make snapshot       - Generate gas snapshots"
	@echo "  make fmt            - Format code"
	@echo "  make lint           - Check formatting"
	@echo "  make clean          - Clean build artifacts"
	@echo "  make deploy-local   - Deploy to Anvil"
	@echo "  make deploy-sepolia - Deploy to Sepolia"
	@echo "  make anvil          - Start Anvil local node"
	@echo "  make zk-compile     - Compile Noir circuit"
	@echo "  make zk-execute     - Execute circuit and generate witness"
	@echo "  make zk-prove       - Generate ZK proof (needs ~2GB RAM)"
	@echo "  make zk-verify      - Verify ZK proof natively"
	@echo "  make zk-verifier    - Generate HonkVerifier Solidity contract"
	@echo "  make sizes          - Show contract sizes"
	@echo "  make help           - Show this help"

